# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# The HMAC secret is shown exactly ONCE in the dashboard at agent registration.
# The Kurier key is free from https://kurier.xyz (signup; may need email verification).

# Required before going live — 32-byte secret from the Agent Games dashboard.
AGENT_GAMES_HMAC_SECRET=

# HMAC construction (defaults match the presumed platform format; confirm via preflight).
# HMAC_SECRET_ENCODING: utf8 (default) or hex — how AGENT_GAMES_HMAC_SECRET is encoded.
# HMAC_ALGORITHM: sha256 (default).
# HMAC_ENCODING: hex (default) or base64 — the header value encoding.
# HMAC_PREFIX: "" (default) — e.g. "sha256=" if the platform prefixes the value.
HMAC_SECRET_ENCODING=utf8
HMAC_ALGORITHM=sha256
HMAC_ENCODING=hex
HMAC_PREFIX=

# Free API key from https://kurier.xyz. Optional — without it, proofs are
# returned locally but not anchored on-chain via Kurier.
KURIER_API_KEY=

# Server.
PORT=8080
HOST=0.0.0.0

# Proving budget per task in ms (platform deadline is 60s). Default 40000.
PROVE_TIMEOUT_MS=40000

# Check 7 (proof on-chain) — mainnet explorer API base URL. Leave blank until
# the URL is confirmed from the dashboard/docs; while blank the lookup is
# skipped. ONCHAIN_INCONCLUSIVE: "pass" (default) or "reject" — what to do
# when the lookup is inconclusive. See src/onchain.mjs.
ZKVERIFY_EXPLORER_API=
ONCHAIN_INCONCLUSIVE=pass

# Paths (defaults are fine).
# STATE_FILE=./data/state.json
# LOG_FILE=./data/agent.log
